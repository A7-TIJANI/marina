# ─────────────────────────────────────────────────────────────────────
# Marina v3.0 — environment variables
#
# Copy this file to .env (local dev) and fill in real values.
#
# DEPLOYING TO VERCEL — READ THIS FIRST:
#   Every variable below must be set in Vercel Dashboard → Project →
#   Settings → Environment Variables for the "Production" environment.
#   A value only existing in your local .env file (which is gitignored
#   and never deployed) will NOT reach the live site — the app will
#   build and deploy successfully, then fail at runtime in ways that
#   can look like application bugs (e.g. login appearing to work but
#   every protected page rejecting the session) rather than obviously
#   missing configuration. Set every variable here BEFORE your first
#   deploy, not after something looks broken.
# ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (pooled, for serverless).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marina_v3"

# Non-pooled connection, used only for running migrations (Neon,
# Vercel Postgres). If your provider only gives you one URL, set both
# to the same value.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/marina_v3"

# Secret used to sign session JWTs (HS256). Generate a real one with:
#   openssl rand -base64 32
# Must be at least 16 characters — the app refuses to start without a
# valid one. Must be set for BOTH the Node.js and Edge runtimes in
# Vercel (this is usually automatic, but double check the "Runtime"
# scope if your Vercel plan/UI exposes one — it must not be Node-only).
AUTH_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed site — no trailing slash. This MUST
# exactly match the real domain your users visit (e.g.
# "https://marina-bay.vercel.app"), not a placeholder or an old
# project name. It's used to build the links inside verification and
# notification emails; if it's wrong, those links 404 for every user.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob storage token, used for storing/serving uploaded
# documents and images. Create one at
# https://vercel.com/dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""

# Rate limiting store (Vercel KV or Upstash Redis REST credentials).
# Required in production — login, register, contact, document upload,
# and admin status-change actions are all rate limited and will FAIL
# CLOSED (deny the action) if this is unreachable in production. Local
# dev fails open instead, so the app still runs without this set
# locally.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Resend API key for transactional email (verification links, status
# updates, payment confirmations, document review notices, contact
# form). Optional — if left empty, emails are logged to the console
# instead of sent, so the app still runs fully without this.
RESEND_API_KEY=""

# Must be an address on a domain you've verified with Resend. Resend
# cannot send FROM a Gmail/Outlook/etc. address — that will fail
# silently or bounce. Resend's own "onboarding@resend.dev" sender
# works for testing but is commonly filtered by Gmail; for real
# deliverability, verify your own domain in the Resend dashboard and
# send from that instead.
EMAIL_FROM="Marina <no-reply@example.com>"

# Where public contact-form submissions get forwarded. Optional —
# submissions are still saved to the database either way.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
